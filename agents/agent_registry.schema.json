{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentRegistry",
  "type": "object",
  "required": ["version", "entities"],
  "properties": {
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "master_seal": {"type": "string", "minLength": 64, "maxLength": 128},
    "generated_at": {"type": "string", "format": "date-time"},
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "ring", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^\\d{4}$"},
          "name": {"type": "string", "minLength": 3},
          "ring": {"type": "string", "enum": ["Ring 0", "Ring 1", "Ring 2", "Ring 3", "Ring 4", "Ring 5", "Ring 6", "Ring Ω"]},
          "talents": {"type": "array", "items": {"type": "string"}},
          "modules": {"type": "array", "items": {"type": "string"}},
          "status": {"type": "string", "enum": ["ACTIVE", "LOCKED", "GENESIS", "DEPRECATED", "QUARANTINED"]},
          "seal": {"type": "string", "pattern": "^[a-f0-9]{32,128}$"}
        }
      }
    }
  }
}
